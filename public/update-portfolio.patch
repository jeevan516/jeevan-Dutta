+        ctx.moveTo(centerX - 24, bodyY + 6);
+        ctx.lineTo(centerX, bodyY + 38);
+        ctx.lineTo(centerX + 24, bodyY + 6);
+        ctx.fillStyle = '#f8fafc';
+        ctx.fill();
